VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=

# Server-side Supabase Edge Function secret. Never prefix with VITE_.
META_APP_SECRET=

# Secret sent by Supabase Cron (HTTP) to the internal due-broadcast endpoint.
# Must be a long random server-side value and must never use a VITE_ prefix.
BROADCAST_SCHEDULER_SECRET=

# Server-side privileged identity. Prefer immutable Supabase Auth user UUID.
# SUPERADMIN_EMAIL is a server-side compatibility fallback only.
SUPERADMIN_USER_ID=
SUPERADMIN_EMAIL=
